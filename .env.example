# Docker Compose 可直接使用內建預設值；僅在需要自訂時複製本檔案為 .env。

# ── 連接埠 ─────────────────────────────────────────────
WEB_PORT=3000
API_PORT=8000
# 本機預設只監聽回環位址；區域網路／伺服器部署請改為 0.0.0.0。
BIND_ADDRESS=127.0.0.1

# ── 本地快速啟動 ───────────────────────────────────────
SAG_ENVIRONMENT=dev
SAG_CORS_ORIGINS=http://localhost:3000
# 關閉傳統信箱註冊介面；本地身份引導不受此設定影響。
SAG_ALLOW_REGISTRATION=false
SAG_SAG_LANGUAGE=zh

# 正式部署必須設定強隨機值（產生指令：openssl rand -hex 32）。
# 本地 dev 留空時，Compose 會使用僅適合本機的開發金鑰。
SAG_SECRET_KEY=

# 瀏覽器存取後端的位址（建置期內嵌；修改後需重新建置 web 映像）。
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Web 預設開啟頁內視窗縮放；桌面用戶端建置時請設為 false。
NEXT_PUBLIC_ENABLE_WINDOW_SCALING=true

# ── LLM / Embedding（也可啟動後在設定頁填寫）──
SAG_LLM_PROVIDER=openai
SAG_LLM_BASE_URL=https://api.302ai.cn/v1
SAG_LLM_API_KEY=
SAG_LLM_MODEL=qwen3.6-flash
SAG_LLM_MAX_TOKENS=20000
# Anthropic / Gemini 原生接入時請將 SAG_LLM_PROVIDER 改為對應值，Base URL 留空以使用官方端點。
SAG_EMBEDDING_MODEL=bge-large-en-v1.5
SAG_EMBEDDING_BASE_URL=https://api.302ai.cn/v1
SAG_EMBEDDING_API_KEY=

# ── 文件解析（PDF 優先使用 MinerU；未設定或失敗時退回 MarkItDown）────
SAG_DOCUMENT_PARSER=auto
SAG_MINERU_BASE_URL=https://api.302ai.cn
SAG_MINERU_API_KEY=
SAG_MINERU_VERSION=2.5

# ── Postgres 正式部署覆蓋設定（compose.postgres.yaml）───────────
POSTGRES_USER=sag
# 正式部署覆蓋必填；建議使用：openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=sag

# ── 穩定性（選填，取消註解後生效）──────────────────────
# SAG_JOB_MAX_ATTEMPTS=3
# SAG_ENGINE_CACHE_SIZE=16
# SAG_ENGINE_WARMUP_COUNT=4
# SAG_MINERU_POLL_TIMEOUT=300
